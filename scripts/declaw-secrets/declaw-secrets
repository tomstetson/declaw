#!/usr/bin/env python3
"""
DeClaw Secrets Manager v2
Multi-provider secrets management for OpenClaw agents.

Supported providers:
- keychain: macOS Keychain (built-in, no dependencies)
- vault: HashiCorp Vault
- bitwarden: Bitwarden CLI
- 1password: 1Password CLI
- env: Environment file (fallback, not recommended)
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Dict, Optional
import platform


class SecretProvider:
    """Base class for secret providers."""

    def get(self, key: str) -> Optional[str]:
        raise NotImplementedError

    def set(self, key: str, value: str) -> None:
        raise NotImplementedError

    def list_keys(self) -> list:
        raise NotImplementedError

    def is_available(self) -> bool:
        """Check if this provider is available on this system."""
        raise NotImplementedError


class KeychainProvider(SecretProvider):
    """macOS Keychain provider - built-in, no dependencies."""

    SERVICE_NAME = "DeClaw"

    def is_available(self) -> bool:
        return platform.system() == "Darwin"

    def get(self, key: str) -> Optional[str]:
        try:
            result = subprocess.run(
                ["security", "find-generic-password",
                 "-s", self.SERVICE_NAME,
                 "-a", key,
                 "-w"],  # -w prints password only
                capture_output=True,
                text=True,
                check=True
            )
            return result.stdout.strip()
        except subprocess.CalledProcessError as e:
            if "could not be found" in e.stderr:
                return None
            raise

    def set(self, key: str, value: str) -> None:
        # Check if exists
        existing = self.get(key)

        if existing:
            # Update existing
            subprocess.run(
                ["security", "add-generic-password",
                 "-s", self.SERVICE_NAME,
                 "-a", key,
                 "-w", value,
                 "-U"],  # Update if exists
                check=True,
                capture_output=True
            )
            print(f"✅ Secret '{key}' updated in macOS Keychain")
        else:
            # Create new
            subprocess.run(
                ["security", "add-generic-password",
                 "-s", self.SERVICE_NAME,
                 "-a", key,
                 "-w", value],
                check=True,
                capture_output=True
            )
            print(f"✅ Secret '{key}' stored in macOS Keychain")

    def list_keys(self) -> list:
        try:
            import re

            result = subprocess.run(
                ["security", "dump-keychain"],
                capture_output=True,
                text=True,
                check=True
            )

            keys = []
            # Split output into per-entry blocks (separated by "keychain:" lines)
            # and only extract account names from blocks matching our service
            entries = re.split(r'(?=^keychain:)', result.stdout, flags=re.MULTILINE)

            for entry in entries:
                # Only look at entries belonging to our service
                if f'svce"<blob>="{self.SERVICE_NAME}"' not in entry \
                        and f'"svce"<blob>="{self.SERVICE_NAME}"' not in entry:
                    continue

                # Extract account name from this entry's block
                match = re.search(r'"acct"<blob>="([^"]+)"', entry)
                if match:
                    keys.append(match.group(1))

            return keys
        except subprocess.CalledProcessError:
            return []


class VaultProvider(SecretProvider):
    """HashiCorp Vault provider."""

    def __init__(self, config: Dict):
        self.addr = config.get("vault", {}).get("addr", os.getenv("VAULT_ADDR", "http://127.0.0.1:8200"))
        self.token = config.get("vault", {}).get("token", os.getenv("VAULT_TOKEN"))
        self.mount = config.get("vault", {}).get("mount", "secret")
        self.path = config.get("vault", {}).get("path", "declaw")

    def is_available(self) -> bool:
        try:
            subprocess.run(["vault", "version"], capture_output=True, check=True)
            return True
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False

    def get(self, key: str) -> Optional[str]:
        if not self.token:
            print("❌ VAULT_TOKEN not set", file=sys.stderr)
            sys.exit(1)

        try:
            # vault kv get -field=value secret/declaw/KEY
            result = subprocess.run(
                ["vault", "kv", "get",
                 "-address", self.addr,
                 "-field", "value",
                 f"{self.mount}/{self.path}/{key}"],
                capture_output=True,
                text=True,
                check=True,
                env={**os.environ, "VAULT_TOKEN": self.token}
            )
            return result.stdout.strip()
        except subprocess.CalledProcessError as e:
            if "No value found" in e.stderr:
                return None
            raise

    def set(self, key: str, value: str) -> None:
        if not self.token:
            print("❌ VAULT_TOKEN not set", file=sys.stderr)
            sys.exit(1)

        # vault kv put secret/declaw/KEY value=VALUE
        subprocess.run(
            ["vault", "kv", "put",
             "-address", self.addr,
             f"{self.mount}/{self.path}/{key}",
             f"value={value}"],
            check=True,
            capture_output=True,
            env={**os.environ, "VAULT_TOKEN": self.token}
        )
        print(f"✅ Secret '{key}' stored in Vault at {self.addr}")

    def list_keys(self) -> list:
        if not self.token:
            return []

        try:
            result = subprocess.run(
                ["vault", "kv", "list",
                 "-address", self.addr,
                 "-format", "json",
                 f"{self.mount}/{self.path}"],
                capture_output=True,
                text=True,
                check=True,
                env={**os.environ, "VAULT_TOKEN": self.token}
            )
            return json.loads(result.stdout)
        except subprocess.CalledProcessError:
            return []


class BitwardenProvider(SecretProvider):
    """Bitwarden CLI provider."""

    def is_available(self) -> bool:
        try:
            subprocess.run(["bw", "--version"], capture_output=True, check=True)
            return True
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False

    def get(self, key: str) -> Optional[str]:
        try:
            # bw get password KEY
            result = subprocess.run(
                ["bw", "get", "password", key],
                capture_output=True,
                text=True,
                check=True
            )
            return result.stdout.strip()
        except subprocess.CalledProcessError as e:
            if "Not found" in e.stderr:
                return None
            elif "not logged in" in e.stderr.lower():
                print("❌ Not logged in to Bitwarden", file=sys.stderr)
                print("Run: bw login && bw unlock", file=sys.stderr)
                sys.exit(1)
            raise

    def set(self, key: str, value: str) -> None:
        # Check if exists
        existing_id = None
        try:
            result = subprocess.run(
                ["bw", "get", "item", key],
                capture_output=True,
                text=True,
                check=True
            )
            item = json.loads(result.stdout)
            existing_id = item["id"]
        except subprocess.CalledProcessError:
            pass

        if existing_id:
            print(f"⚠️  Secret '{key}' already exists in Bitwarden")
            print(f"   Use 'bw edit item {existing_id}' to update")
        else:
            # Create new login item
            template = {
                "type": 1,  # Login
                "name": key,
                "login": {
                    "username": "declaw",
                    "password": value
                }
            }

            result = subprocess.run(
                ["bw", "create", "item"],
                input=json.dumps(template),
                capture_output=True,
                text=True,
                check=True
            )
            print(f"✅ Secret '{key}' stored in Bitwarden")

    def list_keys(self) -> list:
        try:
            result = subprocess.run(
                ["bw", "list", "items"],
                capture_output=True,
                text=True,
                check=True
            )
            items = json.loads(result.stdout)
            return [item["name"] for item in items if item.get("login")]
        except subprocess.CalledProcessError:
            return []


class OnePasswordProvider(SecretProvider):
    """1Password CLI provider."""

    def __init__(self, config: Dict):
        self.vault = config.get("1password", {}).get("vault", "DeClaw")

    def is_available(self) -> bool:
        try:
            subprocess.run(["op", "--version"], capture_output=True, check=True)
            return True
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False

    def get(self, key: str) -> Optional[str]:
        try:
            reference = f"op://{self.vault}/{key}/password"
            result = subprocess.run(
                ["op", "read", reference],
                capture_output=True,
                text=True,
                check=True
            )
            return result.stdout.strip()
        except subprocess.CalledProcessError as e:
            if "isn't in" in e.stderr or "not found" in e.stderr:
                return None
            elif "not signed in" in e.stderr:
                print("❌ Not signed in to 1Password", file=sys.stderr)
                print("Run: eval $(op signin)", file=sys.stderr)
                sys.exit(1)
            raise

    def set(self, key: str, value: str) -> None:
        try:
            subprocess.run(
                ["op", "item", "create",
                 f"--vault={self.vault}",
                 f"--title={key}",
                 "--category=Password",
                 f"password={value}"],
                capture_output=True,
                text=True,
                check=True
            )
            print(f"✅ Secret '{key}' stored in 1Password vault '{self.vault}'")
        except subprocess.CalledProcessError as e:
            if "already exists" in e.stderr:
                print(f"⚠️  Secret '{key}' already exists in 1Password")
            else:
                raise

    def list_keys(self) -> list:
        try:
            result = subprocess.run(
                ["op", "item", "list", f"--vault={self.vault}", "--format=json"],
                capture_output=True,
                text=True,
                check=True
            )
            items = json.loads(result.stdout)
            return [item["title"] for item in items]
        except subprocess.CalledProcessError:
            return []


class EnvFileProvider(SecretProvider):
    """Environment file provider (fallback only)."""

    def __init__(self):
        self.env_file = Path.home() / ".declaw" / "secrets.env"

    def is_available(self) -> bool:
        return True  # Always available

    def get(self, key: str) -> Optional[str]:
        if not self.env_file.exists():
            return None

        with open(self.env_file) as f:
            for line in f:
                line = line.strip()
                if line.startswith("#") or not line or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                if k == key:
                    return v.strip('"').strip("'")
        return None

    def set(self, key: str, value: str) -> None:
        self.env_file.parent.mkdir(parents=True, exist_ok=True)

        lines = []
        found = False

        if self.env_file.exists():
            with open(self.env_file) as f:
                for line in f:
                    if line.strip().startswith(f"{key}="):
                        lines.append(f'{key}="{value}"\n')
                        found = True
                    else:
                        lines.append(line)

        if not found:
            lines.append(f'{key}="{value}"\n')

        with open(self.env_file, "w") as f:
            f.writelines(lines)

        os.chmod(self.env_file, 0o600)
        print(f"✅ Secret '{key}' stored in {self.env_file}")
        print(f"⚠️  WARNING: .env file is NOT SECURE - use keychain/vault for production")

    def list_keys(self) -> list:
        if not self.env_file.exists():
            return []

        keys = []
        with open(self.env_file) as f:
            for line in f:
                line = line.strip()
                if line.startswith("#") or not line or "=" not in line:
                    continue
                keys.append(line.split("=", 1)[0])
        return keys


class SecretsManager:
    """Main secrets manager with provider auto-detection."""

    PROVIDERS = {
        "keychain": KeychainProvider,
        "vault": VaultProvider,
        "bitwarden": BitwardenProvider,
        "1password": OnePasswordProvider,
        "env": EnvFileProvider
    }

    def __init__(self, provider: Optional[str] = None, audit: bool = True):
        self.audit = audit
        self.audit_file = Path.home() / ".declaw" / "audit.log"
        self.config_file = Path.home() / ".declaw" / "secrets-config.json"

        # Load config
        self.config = self._load_config()

        # Auto-detect provider if not specified
        if provider is None:
            provider = self._auto_detect_provider()

        self.provider_name = provider
        self.provider = self._get_provider(provider)

        # Ensure audit directory exists
        self.audit_file.parent.mkdir(parents=True, exist_ok=True)

    def _auto_detect_provider(self) -> str:
        """Auto-detect best available provider."""
        # Priority order
        priorities = ["keychain", "vault", "bitwarden", "1password", "env"]

        for name in priorities:
            provider_class = self.PROVIDERS[name]
            if name == "keychain":
                provider = provider_class()
            elif name in ("vault", "1password"):
                provider = provider_class(self.config)
            else:
                provider = provider_class()

            if provider.is_available():
                print(f"🔍 Auto-detected provider: {name}", file=sys.stderr)
                return name

        # Fallback to env
        return "env"

    def _get_provider(self, name: str) -> SecretProvider:
        """Get provider instance."""
        if name not in self.PROVIDERS:
            raise ValueError(f"Unknown provider: {name}")

        provider_class = self.PROVIDERS[name]

        if name == "keychain":
            return provider_class()
        elif name in ("vault", "1password"):
            return provider_class(self.config)
        else:
            return provider_class()

    def get(self, key: str) -> str:
        """Retrieve a secret."""
        value = self.provider.get(key)

        # Audit log
        if self.audit:
            self._log_access(key, success=value is not None)

        if value is None:
            raise ValueError(f"Secret not found: {key}")

        return value

    def set(self, key: str, value: str) -> None:
        """Store a secret."""
        self.provider.set(key, value)

        # Audit log
        if self.audit:
            self._log_access(key, action="set", success=True)

    def list_keys(self) -> list:
        """List all secrets."""
        return self.provider.list_keys()

    def _log_access(self, key: str, action: str = "get", success: bool = True) -> None:
        """Log secret access to audit file."""
        log_entry = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "event_type": "secret_access",
            "action": action,
            "key": key,
            "success": success,
            "provider": self.provider_name,
            "pid": os.getpid(),
            "user": os.getenv("USER", "unknown")
        }

        with open(self.audit_file, "a") as f:
            f.write(json.dumps(log_entry) + "\n")

    def _load_config(self) -> Dict:
        """Load secrets manager configuration."""
        if not self.config_file.exists():
            return {
                "provider": None,  # Auto-detect
                "vault": {
                    "addr": "http://127.0.0.1:8200",
                    "mount": "secret",
                    "path": "declaw"
                },
                "1password": {
                    "vault": "DeClaw"
                }
            }

        with open(self.config_file) as f:
            return json.load(f)

    def _save_config(self, config: Dict) -> None:
        """Save secrets manager configuration."""
        self.config_file.parent.mkdir(parents=True, exist_ok=True)

        with open(self.config_file, "w") as f:
            json.dump(config, f, indent=2)

        print(f"✅ Configuration saved to {self.config_file}")


# CLI commands (same as before but updated for new providers)

def cmd_get(args):
    manager = SecretsManager(provider=args.provider)
    try:
        value = manager.get(args.key)
        print(value)
    except ValueError as e:
        print(f"❌ {e}", file=sys.stderr)
        sys.exit(1)


def cmd_set(args):
    manager = SecretsManager(provider=args.provider)

    if args.value:
        value = args.value
    else:
        import getpass
        value = getpass.getpass(f"Enter value for {args.key}: ")

    manager.set(args.key, value)


def cmd_list(args):
    manager = SecretsManager(provider=args.provider)
    keys = manager.list_keys()

    if not keys:
        print("No secrets found")
    else:
        print(f"Secrets in {manager.provider_name}:")
        for key in keys:
            print(f"  - {key}")


def cmd_audit(args):
    audit_file = Path.home() / ".declaw" / "audit.log"

    if not audit_file.exists():
        print("No audit log found")
        return

    with open(audit_file) as f:
        for line in f:
            entry = json.loads(line)

            if args.key and entry.get("key") != args.key:
                continue

            timestamp = entry["timestamp"]
            action = entry["action"]
            key = entry["key"]
            provider = entry.get("provider", "unknown")
            success = "✅" if entry["success"] else "❌"

            print(f"{timestamp} {success} {action} {key} ({provider})")


def cmd_providers(args):
    """List available providers."""
    manager = SecretsManager()

    print("Available providers:\n")

    for name, provider_class in SecretsManager.PROVIDERS.items():
        if name == "keychain":
            provider = provider_class()
        elif name in ("vault", "1password"):
            provider = provider_class(manager.config)
        else:
            provider = provider_class()

        available = "✅" if provider.is_available() else "❌"

        descriptions = {
            "keychain": "macOS Keychain (built-in, recommended on Mac)",
            "vault": "HashiCorp Vault (enterprise secrets management)",
            "bitwarden": "Bitwarden CLI (open source, self-hostable)",
            "1password": "1Password CLI (commercial)",
            "env": "Environment file (fallback, NOT SECURE)"
        }

        print(f"{available} {name:12s} - {descriptions[name]}")


def main():
    parser = argparse.ArgumentParser(
        description="DeClaw Secrets Manager - Multi-provider secrets for OpenClaw agents"
    )

    parser.add_argument(
        "--provider",
        choices=list(SecretsManager.PROVIDERS.keys()),
        default=None,  # Auto-detect
        help="Secrets provider to use (auto-detects if not specified)"
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    # get
    get_parser = subparsers.add_parser("get", help="Retrieve a secret")
    get_parser.add_argument("key")
    get_parser.set_defaults(func=cmd_get)

    # set
    set_parser = subparsers.add_parser("set", help="Store a secret")
    set_parser.add_argument("key")
    set_parser.add_argument("value", nargs="?")
    set_parser.set_defaults(func=cmd_set)

    # list
    list_parser = subparsers.add_parser("list", help="List all secrets")
    list_parser.set_defaults(func=cmd_list)

    # audit
    audit_parser = subparsers.add_parser("audit", help="Show audit log")
    audit_parser.add_argument("--key", help="Filter by key")
    audit_parser.set_defaults(func=cmd_audit)

    # providers
    providers_parser = subparsers.add_parser("providers", help="List available providers")
    providers_parser.set_defaults(func=cmd_providers)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
