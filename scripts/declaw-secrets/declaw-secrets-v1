#!/usr/bin/env python3
"""
DeClaw Secrets Manager
Secure secrets management for OpenClaw agents using 1Password CLI, Vault, or other providers.
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Dict, Optional


class SecretsManager:
    """Core secrets management functionality."""

    def __init__(self, provider: str = "1password", audit: bool = True):
        self.provider = provider
        self.audit = audit
        self.audit_file = Path.home() / ".declaw" / "audit.log"
        self.config_file = Path.home() / ".declaw" / "secrets-config.json"

        # Ensure audit directory exists
        self.audit_file.parent.mkdir(parents=True, exist_ok=True)

    def get(self, key: str) -> str:
        """Retrieve a secret from the configured provider."""
        value = None

        if self.provider == "1password":
            value = self._get_from_1password(key)
        elif self.provider == "vault":
            value = self._get_from_vault(key)
        elif self.provider == "env":
            value = self._get_from_env(key)
        else:
            raise ValueError(f"Unknown provider: {self.provider}")

        # Audit log
        if self.audit:
            self._log_access(key, success=value is not None)

        if value is None:
            raise ValueError(f"Secret not found: {key}")

        return value

    def set(self, key: str, value: str) -> None:
        """Store a secret in the configured provider."""
        if self.provider == "1password":
            self._set_in_1password(key, value)
        elif self.provider == "vault":
            self._set_in_vault(key, value)
        elif self.provider == "env":
            self._set_in_env(key, value)
        else:
            raise ValueError(f"Unknown provider: {self.provider}")

        # Audit log
        if self.audit:
            self._log_access(key, action="set", success=True)

    def list_keys(self) -> list:
        """List all available secret keys."""
        if self.provider == "1password":
            return self._list_from_1password()
        elif self.provider == "vault":
            return self._list_from_vault()
        elif self.provider == "env":
            return self._list_from_env()
        else:
            raise ValueError(f"Unknown provider: {self.provider}")

    # 1Password provider implementation
    def _get_from_1password(self, key: str) -> Optional[str]:
        """Retrieve secret from 1Password CLI."""
        try:
            # Get vault from config
            config = self._load_config()
            vault = config.get("1password", {}).get("vault", "DeClaw")

            # op read "op://vault/item/field"
            # We store secrets as: op://DeClaw/SHODAN_API_KEY/password
            reference = f"op://{vault}/{key}/password"

            result = subprocess.run(
                ["op", "read", reference],
                capture_output=True,
                text=True,
                check=True
            )
            return result.stdout.strip()

        except subprocess.CalledProcessError as e:
            # Check if it's "not found" vs authentication error
            if "isn't in" in e.stderr or "not found" in e.stderr:
                return None
            elif "not signed in" in e.stderr or "authentication" in e.stderr.lower():
                print("❌ Not signed in to 1Password CLI", file=sys.stderr)
                print("Run: eval $(op signin)", file=sys.stderr)
                sys.exit(1)
            else:
                raise

        except FileNotFoundError:
            print("❌ 1Password CLI not found", file=sys.stderr)
            print("Install: https://1password.com/downloads/command-line/", file=sys.stderr)
            sys.exit(1)

    def _set_in_1password(self, key: str, value: str) -> None:
        """Store secret in 1Password CLI."""
        try:
            config = self._load_config()
            vault = config.get("1password", {}).get("vault", "DeClaw")

            # Create item: op item create --vault=DeClaw --title=KEY --category=Password password=VALUE
            subprocess.run(
                [
                    "op", "item", "create",
                    f"--vault={vault}",
                    f"--title={key}",
                    "--category=Password",
                    f"password={value}"
                ],
                capture_output=True,
                text=True,
                check=True
            )
            print(f"✅ Secret '{key}' stored in 1Password vault '{vault}'")

        except subprocess.CalledProcessError as e:
            if "already exists" in e.stderr:
                # Update existing item
                print(f"⚠️  Secret '{key}' already exists. Use 'declaw-secrets update' to change it.")
            else:
                print(f"❌ Failed to store secret: {e.stderr}", file=sys.stderr)
                sys.exit(1)

    def _list_from_1password(self) -> list:
        """List all secrets in 1Password vault."""
        try:
            config = self._load_config()
            vault = config.get("1password", {}).get("vault", "DeClaw")

            # op item list --vault=DeClaw --format=json
            result = subprocess.run(
                ["op", "item", "list", f"--vault={vault}", "--format=json"],
                capture_output=True,
                text=True,
                check=True
            )

            items = json.loads(result.stdout)
            return [item["title"] for item in items]

        except subprocess.CalledProcessError as e:
            print(f"❌ Failed to list secrets: {e.stderr}", file=sys.stderr)
            sys.exit(1)

    # Environment file provider implementation
    def _get_from_env(self, key: str) -> Optional[str]:
        """Retrieve secret from .env file."""
        env_file = Path.home() / ".declaw" / "secrets.env"

        if not env_file.exists():
            return None

        with open(env_file) as f:
            for line in f:
                line = line.strip()
                if line.startswith("#") or not line:
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    if k == key:
                        return v.strip('"').strip("'")

        return None

    def _set_in_env(self, key: str, value: str) -> None:
        """Store secret in .env file."""
        env_file = Path.home() / ".declaw" / "secrets.env"
        env_file.parent.mkdir(parents=True, exist_ok=True)

        # Read existing
        lines = []
        found = False

        if env_file.exists():
            with open(env_file) as f:
                for line in f:
                    if line.strip().startswith(f"{key}="):
                        lines.append(f'{key}="{value}"\n')
                        found = True
                    else:
                        lines.append(line)

        # Append if not found
        if not found:
            lines.append(f'{key}="{value}"\n')

        # Write back
        with open(env_file, "w") as f:
            f.writelines(lines)

        # Set restrictive permissions
        os.chmod(env_file, 0o600)

        print(f"✅ Secret '{key}' stored in {env_file}")
        print(f"⚠️  WARNING: .env file storage is not recommended for production")

    def _list_from_env(self) -> list:
        """List all secrets in .env file."""
        env_file = Path.home() / ".declaw" / "secrets.env"

        if not env_file.exists():
            return []

        keys = []
        with open(env_file) as f:
            for line in f:
                line = line.strip()
                if line.startswith("#") or not line or "=" not in line:
                    continue
                key = line.split("=", 1)[0]
                keys.append(key)

        return keys

    # Vault provider (stub for now)
    def _get_from_vault(self, key: str) -> Optional[str]:
        """Retrieve secret from HashiCorp Vault."""
        raise NotImplementedError("Vault provider not yet implemented")

    def _set_in_vault(self, key: str, value: str) -> None:
        """Store secret in HashiCorp Vault."""
        raise NotImplementedError("Vault provider not yet implemented")

    def _list_from_vault(self) -> list:
        """List all secrets in Vault."""
        raise NotImplementedError("Vault provider not yet implemented")

    # Audit logging
    def _log_access(self, key: str, action: str = "get", success: bool = True) -> None:
        """Log secret access to audit file."""
        log_entry = {
            "timestamp": datetime.utcnow().isoformat() + "Z",
            "event_type": "secret_access",
            "action": action,
            "key": key,
            "success": success,
            "provider": self.provider,
            "pid": os.getpid(),
            "user": os.getenv("USER", "unknown")
        }

        with open(self.audit_file, "a") as f:
            f.write(json.dumps(log_entry) + "\n")

    # Config management
    def _load_config(self) -> Dict:
        """Load secrets manager configuration."""
        if not self.config_file.exists():
            # Default config
            return {
                "provider": "1password",
                "1password": {
                    "vault": "DeClaw"
                }
            }

        with open(self.config_file) as f:
            return json.load(f)

    def _save_config(self, config: Dict) -> None:
        """Save secrets manager configuration."""
        self.config_file.parent.mkdir(parents=True, exist_ok=True)

        with open(self.config_file, "w") as f:
            json.dump(config, f, indent=2)

        print(f"✅ Configuration saved to {self.config_file}")


def cmd_get(args):
    """Get a secret."""
    manager = SecretsManager(provider=args.provider)
    try:
        value = manager.get(args.key)
        print(value)
    except ValueError as e:
        print(f"❌ {e}", file=sys.stderr)
        sys.exit(1)


def cmd_set(args):
    """Set a secret."""
    manager = SecretsManager(provider=args.provider)

    # Read value from stdin or prompt
    if args.value:
        value = args.value
    else:
        import getpass
        value = getpass.getpass(f"Enter value for {args.key}: ")

    manager.set(args.key, value)


def cmd_list(args):
    """List all secrets."""
    manager = SecretsManager(provider=args.provider)
    keys = manager.list_keys()

    if not keys:
        print("No secrets found")
    else:
        print(f"Secrets in {args.provider}:")
        for key in keys:
            print(f"  - {key}")


def cmd_audit(args):
    """Show audit log."""
    audit_file = Path.home() / ".declaw" / "audit.log"

    if not audit_file.exists():
        print("No audit log found")
        return

    # Read and optionally filter audit log
    with open(audit_file) as f:
        for line in f:
            entry = json.loads(line)

            # Filter by key if specified
            if args.key and entry.get("key") != args.key:
                continue

            # Filter by timeframe if specified
            if args.since:
                # TODO: Parse --since and filter
                pass

            # Pretty print
            timestamp = entry["timestamp"]
            action = entry["action"]
            key = entry["key"]
            success = "✅" if entry["success"] else "❌"

            print(f"{timestamp} {success} {action} {key}")


def cmd_config(args):
    """Configure secrets manager."""
    manager = SecretsManager()
    config = manager._load_config()

    if args.provider:
        config["provider"] = args.provider

    if args.vault:
        if "1password" not in config:
            config["1password"] = {}
        config["1password"]["vault"] = args.vault

    manager._save_config(config)


def main():
    parser = argparse.ArgumentParser(
        description="DeClaw Secrets Manager - Secure secrets for OpenClaw agents"
    )

    parser.add_argument(
        "--provider",
        choices=["1password", "vault", "env"],
        default=os.getenv("DECLAW_SECRETS_PROVIDER", "1password"),
        help="Secrets provider to use"
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    # get command
    get_parser = subparsers.add_parser("get", help="Retrieve a secret")
    get_parser.add_argument("key", help="Secret key to retrieve")
    get_parser.set_defaults(func=cmd_get)

    # set command
    set_parser = subparsers.add_parser("set", help="Store a secret")
    set_parser.add_argument("key", help="Secret key to store")
    set_parser.add_argument("value", nargs="?", help="Secret value (prompted if not provided)")
    set_parser.set_defaults(func=cmd_set)

    # list command
    list_parser = subparsers.add_parser("list", help="List all secrets")
    list_parser.set_defaults(func=cmd_list)

    # audit command
    audit_parser = subparsers.add_parser("audit", help="Show audit log")
    audit_parser.add_argument("--key", help="Filter by secret key")
    audit_parser.add_argument("--since", help="Show entries since (e.g., '24h', '7d')")
    audit_parser.set_defaults(func=cmd_audit)

    # config command
    config_parser = subparsers.add_parser("config", help="Configure secrets manager")
    config_parser.add_argument("--provider", choices=["1password", "vault", "env"])
    config_parser.add_argument("--vault", help="1Password vault name")
    config_parser.set_defaults(func=cmd_config)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
