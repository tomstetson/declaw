#!/usr/bin/env python3
"""
DeClaw Monitor - Real-time Anomaly Detection
Monitors OpenClaw session transcripts for suspicious agent behavior.
"""

import argparse
import json
import os
import re
import smtplib
import subprocess
import ssl
import sys
import time
from datetime import datetime, timezone
from email.mime.text import MIMEText
from pathlib import Path
from typing import Dict, List, Optional
from urllib.error import URLError
from urllib.parse import parse_qs, urlparse
from urllib.request import Request, urlopen


class DetectionPattern:
    """Anomaly detection pattern."""

    def __init__(self, id: str, name: str, severity: str, regex: str,
                 action: str = "alert", description: str = ""):
        self.id = id
        self.name = name
        self.severity = severity  # CRITICAL, HIGH, MEDIUM, LOW
        self.regex = re.compile(regex, re.IGNORECASE)
        self.action = action  # "alert", "kill", "block"
        self.description = description


class AlertDispatcher:
    """Sends alerts to one or more destinations based on URL scheme.

    Supported schemes:
      - telegram://BOT_TOKEN@CHAT_ID
      - slack://hooks.slack.com/services/... (or any hooks.slack.com URL)
      - smtp://user:pass@host:port?to=addr&from=sender&subject=...
      - https://... or http://... — generic JSON POST webhook
    """

    RETRY_DELAY_SEC = 2
    TIMEOUT_SEC = 10

    def __init__(self, webhook_urls: Optional[str] = None, verbose: bool = False):
        self.verbose = verbose
        self.destinations: List[str] = []
        self.send_count = 0
        self.fail_count = 0

        if webhook_urls:
            # Support comma-separated URLs
            for url in webhook_urls.split(","):
                stripped = url.strip()
                if stripped:
                    self.destinations.append(stripped)

    @property
    def configured(self) -> bool:
        return len(self.destinations) > 0

    def send(self, pattern: "DetectionPattern", agent_id: str,
             context: str, action_taken: str = "alert") -> int:
        """Send alert to all configured destinations. Returns success count."""
        if not self.configured:
            return 0

        payload = self._build_payload(pattern, agent_id, context, action_taken)
        sent = 0

        for dest in self.destinations:
            ok = self._dispatch(dest, payload)
            if ok:
                sent += 1
                self.send_count += 1
            else:
                self.fail_count += 1

        return sent

    def _build_payload(self, pattern: "DetectionPattern", agent_id: str,
                       context: str, action_taken: str) -> Dict:
        return {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "source": "declaw-monitor",
            "severity": pattern.severity,
            "pattern_id": pattern.id,
            "pattern_name": pattern.name,
            "description": pattern.description,
            "agent_id": agent_id,
            "action_taken": action_taken,
            "context": context[:500],
        }

    def _dispatch(self, dest: str, payload: Dict) -> bool:
        """Route to the correct sender based on URL scheme."""
        parsed = urlparse(dest)

        try:
            if parsed.scheme == "telegram":
                return self._send_telegram(parsed, payload)
            elif "hooks.slack.com" in dest or parsed.scheme == "slack":
                return self._send_slack(dest, payload)
            elif parsed.scheme == "smtp":
                return self._send_smtp(parsed, payload)
            elif parsed.scheme in ("https", "http"):
                return self._send_webhook(dest, payload)
            else:
                if self.verbose:
                    print(f"   ⚠️  Unknown alert scheme: {parsed.scheme}")
                return False
        except Exception as e:
            if self.verbose:
                print(f"   ❌ Alert failed ({dest[:40]}...): {e}")
            # Retry once
            try:
                time.sleep(self.RETRY_DELAY_SEC)
                if parsed.scheme == "telegram":
                    return self._send_telegram(parsed, payload)
                elif "hooks.slack.com" in dest or parsed.scheme == "slack":
                    return self._send_slack(dest, payload)
                elif parsed.scheme == "smtp":
                    return self._send_smtp(parsed, payload)
                elif parsed.scheme in ("https", "http"):
                    return self._send_webhook(dest, payload)
            except Exception:
                pass
            return False

    def _send_webhook(self, url: str, payload: Dict) -> bool:
        """Generic JSON POST to any HTTP(S) URL."""
        data = json.dumps(payload).encode("utf-8")
        req = Request(url, data=data, method="POST")
        req.add_header("Content-Type", "application/json")
        req.add_header("User-Agent", "DeClaw-Monitor/1.0")

        resp = urlopen(req, timeout=self.TIMEOUT_SEC)
        ok = 200 <= resp.status < 300
        if self.verbose:
            print(f"   📨 Webhook POST → {resp.status}")
        return ok

    def _send_telegram(self, parsed, payload: Dict) -> bool:
        """Send via Telegram Bot API: telegram://BOT_TOKEN@CHAT_ID"""
        bot_token = parsed.username or parsed.netloc.split("@")[0]
        chat_id = parsed.hostname or parsed.netloc.split("@")[-1]

        if not bot_token or not chat_id:
            raise ValueError("Telegram URL format: telegram://BOT_TOKEN@CHAT_ID")

        severity_emoji = {"CRITICAL": "🚨", "HIGH": "⚠️", "MEDIUM": "⚡", "LOW": "ℹ️"}
        emoji = severity_emoji.get(payload["severity"], "📋")

        text = (
            f"{emoji} *DeClaw Alert*\n\n"
            f"*Severity:* {payload['severity']}\n"
            f"*Pattern:* {payload['pattern_name']}\n"
            f"*Agent:* `{payload['agent_id']}`\n"
            f"*Action:* {payload['action_taken'].upper()}\n"
            f"*Description:* {payload['description']}\n\n"
            f"`{payload['context'][:200]}`"
        )

        api_url = f"https://api.telegram.org/bot{bot_token}/sendMessage"
        body = json.dumps({
            "chat_id": chat_id,
            "text": text,
            "parse_mode": "Markdown",
            "disable_web_page_preview": True,
        }).encode("utf-8")

        req = Request(api_url, data=body, method="POST")
        req.add_header("Content-Type", "application/json")

        resp = urlopen(req, timeout=self.TIMEOUT_SEC)
        result = json.loads(resp.read().decode("utf-8"))
        ok = result.get("ok", False)
        if self.verbose:
            print(f"   📨 Telegram → {'sent' if ok else 'failed'}")
        return ok

    def _send_slack(self, dest: str, payload: Dict) -> bool:
        """Send via Slack incoming webhook."""
        url = dest
        # Normalize slack:// scheme to https://
        if url.startswith("slack://"):
            url = url.replace("slack://", "https://", 1)

        severity_emoji = {"CRITICAL": ":rotating_light:", "HIGH": ":warning:",
                          "MEDIUM": ":zap:", "LOW": ":information_source:"}
        emoji = severity_emoji.get(payload["severity"], ":memo:")

        body = json.dumps({
            "text": (
                f"{emoji} *DeClaw Alert — {payload['severity']}*\n"
                f"Pattern: {payload['pattern_name']}\n"
                f"Agent: `{payload['agent_id']}`\n"
                f"Action: {payload['action_taken'].upper()}\n"
                f"```{payload['context'][:300]}```"
            ),
        }).encode("utf-8")

        req = Request(url, data=body, method="POST")
        req.add_header("Content-Type", "application/json")

        resp = urlopen(req, timeout=self.TIMEOUT_SEC)
        ok = resp.status == 200
        if self.verbose:
            print(f"   📨 Slack → {resp.status}")
        return ok

    def _send_smtp(self, parsed, payload: Dict) -> bool:
        """Send email via SMTP: smtp://user:pass@host:port?to=addr&from=sender"""
        host = parsed.hostname or "localhost"
        port = parsed.port or 587
        user = parsed.username or ""
        password = parsed.password or ""

        params = parse_qs(parsed.query)
        to_addr = params.get("to", [""])[0]
        from_addr = params.get("from", [user])[0]
        subject_prefix = params.get("subject", ["DeClaw Alert"])[0]

        if not to_addr:
            raise ValueError("SMTP URL must include ?to=recipient@example.com")

        subject = f"[{payload['severity']}] {subject_prefix}: {payload['pattern_name']}"

        body_text = (
            f"DeClaw Monitor Alert\n"
            f"{'=' * 40}\n\n"
            f"Severity: {payload['severity']}\n"
            f"Pattern: {payload['pattern_name']} ({payload['pattern_id']})\n"
            f"Agent: {payload['agent_id']}\n"
            f"Action: {payload['action_taken'].upper()}\n"
            f"Time: {payload['timestamp']}\n\n"
            f"Description:\n{payload['description']}\n\n"
            f"Context:\n{payload['context']}\n"
        )

        msg = MIMEText(body_text)
        msg["Subject"] = subject
        msg["From"] = from_addr
        msg["To"] = to_addr

        ctx = ssl.create_default_context()
        with smtplib.SMTP(host, port, timeout=self.TIMEOUT_SEC) as server:
            server.starttls(context=ctx)
            if user and password:
                server.login(user, password)
            server.sendmail(from_addr, [to_addr], msg.as_string())

        if self.verbose:
            print(f"   📨 Email → {to_addr}")
        return True


class AnomalyDetector:
    """Real-time anomaly detection for OpenClaw agents."""

    def __init__(self, openclaw_dir: Path, alert_webhook: Optional[str] = None,
                 kill_switch: bool = False, verbose: bool = False):
        self.openclaw_dir = openclaw_dir
        self.agents_dir = openclaw_dir / "agents"
        self.alert_webhook = alert_webhook
        self.kill_switch_enabled = kill_switch
        self.verbose = verbose
        self.alert_dispatcher = AlertDispatcher(
            webhook_urls=alert_webhook, verbose=verbose
        )

        # Audit log
        self.audit_file = Path.home() / ".declaw" / "monitor-audit.log"
        self.audit_file.parent.mkdir(parents=True, exist_ok=True)

        # Detection counters
        self.detections = {
            "CRITICAL": 0,
            "HIGH": 0,
            "MEDIUM": 0,
            "LOW": 0
        }

        # Session file positions (for tail -f behavior)
        self.file_positions = {}

        # Patterns
        self.patterns = self._load_patterns()

    def _load_patterns(self) -> List[DetectionPattern]:
        """Load detection patterns."""
        return [
            # CRITICAL - Environment variable access
            DetectionPattern(
                "ENV_ACCESS",
                "Environment variable access",
                "CRITICAL",
                r"(printenv|\benv\b|os\.environ|process\.env|/proc/self/environ|\$\(env\)|export.*KEY)",
                action="kill",
                description="Agent attempting to read environment variables (likely credential theft)"
            ),

            # CRITICAL - Base64 encoding (data exfiltration)
            DetectionPattern(
                "BASE64_ENCODE",
                "Base64 encoding",
                "CRITICAL",
                r"(base64|xxd|openssl enc|uuencode|btoa\()",
                action="kill",
                description="Agent encoding data (possible exfiltration)"
            ),

            # HIGH - Network exfiltration tools
            DetectionPattern(
                "EXFIL_TOOLS",
                "Data exfiltration tools",
                "HIGH",
                r"(curl.*-d|wget.*--post|nc.*-e|socat|ncat)",
                action="alert",
                description="Agent using tools commonly used for data exfiltration"
            ),

            # HIGH - Reverse shell attempts
            DetectionPattern(
                "REVERSE_SHELL",
                "Reverse shell attempt",
                "HIGH",
                r"(bash.*-i|sh.*-i|/bin/.*<&|>&|python.*pty\.spawn|perl.*socket)",
                action="kill",
                description="Agent attempting to spawn reverse shell"
            ),

            # HIGH - Credential scanning
            DetectionPattern(
                "CRED_SCAN",
                "Credential scanning",
                "HIGH",
                r"(grep.*-r.*password|find.*\.ssh|cat.*/etc/shadow|aws.*configure.*list)",
                action="alert",
                description="Agent scanning for credentials on filesystem"
            ),

            # MEDIUM - Suspicious file operations
            DetectionPattern(
                "SUSPICIOUS_FILES",
                "Suspicious file operations",
                "MEDIUM",
                r"(rm.*-rf.*\*|chmod.*777|chown.*root|dd.*if=)",
                action="alert",
                description="Agent performing potentially destructive file operations"
            ),

            # MEDIUM - Port scanning
            DetectionPattern(
                "PORT_SCAN",
                "Port scanning",
                "MEDIUM",
                r"(nmap.*-p|masscan|zmap|unicornscan)",
                action="alert",
                description="Agent performing network reconnaissance"
            ),

            # MEDIUM - Docker escape attempts
            DetectionPattern(
                "DOCKER_ESCAPE",
                "Docker escape attempt",
                "MEDIUM",
                r"(docker\.sock|/var/run/docker|runc|cgroups)",
                action="kill",
                description="Agent attempting to escape Docker container"
            ),

            # LOW - Rapid API calls
            DetectionPattern(
                "API_SPAM",
                "Rapid API calls",
                "LOW",
                r"(web_fetch|web_search|browser)",
                action="alert",
                description="High frequency of API calls (possible abuse)"
            ),

            # LOW - Large file writes
            DetectionPattern(
                "LARGE_WRITE",
                "Large file write",
                "LOW",
                r"(dd.*bs=|fallocate|truncate.*-s.*[MGT])",
                action="alert",
                description="Agent writing large files (possible disk filling)"
            ),
        ]

    def monitor(self, agent_id: Optional[str] = None):
        """Start monitoring sessions."""
        print(f"🔍 DeClaw Monitor starting...")
        print(f"   Monitoring: {self.openclaw_dir}")
        print(f"   Kill switch: {'ENABLED' if self.kill_switch_enabled else 'DISABLED'}")
        if self.alert_dispatcher.configured:
            print(f"   Webhooks: {len(self.alert_dispatcher.destinations)} destination(s)")
        else:
            print(f"   Webhooks: none (use --webhook to enable alerts)")
        print(f"   Patterns: {len(self.patterns)} loaded\n")

        # Find session files
        session_files = self._find_session_files(agent_id)

        if not session_files:
            print(f"❌ No session files found in {self.agents_dir}")
            sys.exit(1)

        print(f"📂 Watching {len(session_files)} session file(s):")
        for sf in session_files:
            print(f"   - {sf.relative_to(self.openclaw_dir)}")
        print()

        # Monitor loop
        try:
            while True:
                for session_file in session_files:
                    self._check_file(session_file)

                time.sleep(0.5)  # Check every 500ms

        except KeyboardInterrupt:
            print("\n\n🛑 Monitor stopped by user")
            self._print_summary()

    def _find_session_files(self, agent_id: Optional[str] = None) -> List[Path]:
        """Find all session .jsonl files."""
        session_files = []

        if agent_id:
            # Specific agent
            agent_dir = self.agents_dir / agent_id / "sessions"
            if agent_dir.exists():
                session_files.extend(agent_dir.glob("*.jsonl"))
        else:
            # All agents
            for agent_dir in self.agents_dir.glob("*/sessions"):
                session_files.extend(agent_dir.glob("*.jsonl"))

        return [f for f in session_files if f.stat().st_size > 0]

    def _check_file(self, session_file: Path):
        """Check file for new content (tail -f behavior)."""
        # Get last known position
        last_pos = self.file_positions.get(str(session_file), 0)

        # Read new content
        try:
            with open(session_file, 'r') as f:
                f.seek(last_pos)
                new_lines = f.readlines()
                new_pos = f.tell()

            # Update position
            self.file_positions[str(session_file)] = new_pos

            # Analyze new lines
            for line in new_lines:
                self._analyze_line(line, session_file)

        except FileNotFoundError:
            # Session file deleted/rotated
            if str(session_file) in self.file_positions:
                del self.file_positions[str(session_file)]

    def _analyze_line(self, line: str, session_file: Path):
        """Analyze a single line from session transcript."""
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            return

        # Extract agent ID from file path
        agent_id = session_file.parent.parent.name

        # Check tool calls
        if entry.get("type") == "tool_use":
            tool_name = entry.get("name", "")
            tool_input = json.dumps(entry.get("input", {}))

            # Check against patterns
            for pattern in self.patterns:
                if pattern.regex.search(tool_input):
                    self._handle_detection(pattern, entry, agent_id, session_file, tool_input)

    def _handle_detection(self, pattern: DetectionPattern, entry: Dict,
                         agent_id: str, session_file: Path, context: str):
        """Handle a pattern detection."""
        detection = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "event_type": "anomaly_detected",
            "pattern_id": pattern.id,
            "pattern_name": pattern.name,
            "severity": pattern.severity,
            "agent_id": agent_id,
            "session_file": str(session_file),
            "tool": entry.get("name", "unknown"),
            "context": context[:200],  # First 200 chars
            "action": pattern.action
        }

        # Log to audit
        self._log_detection(detection)

        # Update counters
        self.detections[pattern.severity] += 1

        # Print alert
        self._print_alert(pattern, agent_id, context)

        # Take action
        if pattern.action == "kill" and self.kill_switch_enabled:
            self._kill_container(agent_id, pattern)
            # Also send alert notification after kill
            self._send_alert(pattern, agent_id, context, action_taken="kill")
        elif pattern.action == "alert":
            self._send_alert(pattern, agent_id, context, action_taken="alert")

    def _print_alert(self, pattern: DetectionPattern, agent_id: str, context: str):
        """Print detection alert."""
        emoji = {
            "CRITICAL": "🚨",
            "HIGH": "⚠️ ",
            "MEDIUM": "⚠️ ",
            "LOW": "ℹ️ "
        }

        print(f"\n{emoji[pattern.severity]} [{pattern.severity}] {pattern.name}")
        print(f"   Agent: {agent_id}")
        print(f"   Pattern: {pattern.id}")
        print(f"   Context: {context[:100]}...")
        print(f"   Action: {pattern.action.upper()}")

    def _log_detection(self, detection: Dict):
        """Log detection to audit file."""
        with open(self.audit_file, 'a') as f:
            f.write(json.dumps(detection) + "\n")

    @staticmethod
    def _validate_agent_id(agent_id: str) -> bool:
        """Validate agent_id is safe to use in Docker filter.

        agent_id comes from filesystem directory names (session_file.parent.parent.name).
        Strict validation prevents Docker filter injection via crafted directory names.
        """
        import re
        return bool(re.match(r'^[A-Za-z0-9_.-]+$', agent_id)) and len(agent_id) <= 128

    def _kill_container(self, agent_id: str, pattern: DetectionPattern):
        """Kill agent container (emergency stop)."""
        if not self._validate_agent_id(agent_id):
            print(f"\n❌ KILL SWITCH ABORTED - Invalid agent ID: {repr(agent_id)}")
            print(f"   Agent ID must be alphanumeric (with . _ -) and <= 128 chars")
            return

        print(f"\n💀 KILL SWITCH ACTIVATED - Stopping agent '{agent_id}'")

        try:
            # Find container — use exact match filter to prevent partial-name hits
            result = subprocess.run(
                ["docker", "ps", "--filter", f"name=^{agent_id}$", "--format", "{{.ID}}"],
                capture_output=True,
                text=True,
                check=True
            )

            container_id = result.stdout.strip()

            if container_id:
                # Kill container
                subprocess.run(
                    ["docker", "kill", container_id],
                    check=True,
                    capture_output=True
                )
                print(f"   ✅ Container {container_id[:12]} killed")

                # Create block file (prevent restart)
                block_file = Path.home() / ".declaw" / f"{agent_id}.blocked"
                with open(block_file, 'w') as f:
                    f.write(json.dumps({
                        "timestamp": datetime.now(timezone.utc).isoformat(),
                        "pattern": pattern.id,
                        "severity": pattern.severity,
                        "reason": pattern.description
                    }, indent=2))

                print(f"   🚫 Agent blocked: {block_file}")
                print(f"   ⚠️  Manual review required before restart")

            else:
                print(f"   ⚠️  Container not found (may already be stopped)")

        except subprocess.CalledProcessError as e:
            print(f"   ❌ Failed to kill container: {e}")

    def _send_alert(self, pattern: DetectionPattern, agent_id: str,
                    context: str, action_taken: str = "alert"):
        """Send alert to all configured destinations."""
        if not self.alert_dispatcher.configured:
            if self.verbose:
                print(f"   📨 No webhook configured (use --webhook to enable alerts)")
            return

        sent = self.alert_dispatcher.send(pattern, agent_id, context, action_taken)
        if self.verbose and sent == 0:
            print(f"   ❌ Failed to send alert to any destination")

    def _print_summary(self):
        """Print detection summary."""
        print("\n" + "="*60)
        print("📊 Detection Summary")
        print("="*60)

        total = sum(self.detections.values())
        if total == 0:
            print("✅ No anomalies detected")
        else:
            print(f"🚨 Total detections: {total}")
            for severity, count in self.detections.items():
                if count > 0:
                    print(f"   {severity}: {count}")

        if self.alert_dispatcher.configured:
            print(f"\n📨 Alerts: {self.alert_dispatcher.send_count} sent, "
                  f"{self.alert_dispatcher.fail_count} failed")

        print(f"\n📁 Audit log: {self.audit_file}")
        print("="*60 + "\n")


def cmd_monitor(args):
    """Start monitoring."""
    openclaw_dir = Path(args.openclaw_dir).expanduser()

    if not openclaw_dir.exists():
        print(f"❌ OpenClaw directory not found: {openclaw_dir}", file=sys.stderr)
        sys.exit(1)

    detector = AnomalyDetector(
        openclaw_dir=openclaw_dir,
        alert_webhook=args.webhook,
        kill_switch=args.kill_switch,
        verbose=args.verbose
    )

    detector.monitor(agent_id=args.agent)


def cmd_audit(args):
    """Show detection audit log."""
    audit_file = Path.home() / ".declaw" / "monitor-audit.log"

    if not audit_file.exists():
        print("No detections logged yet")
        return

    # Read and filter
    with open(audit_file) as f:
        for line in f:
            entry = json.loads(line)

            # Filter by agent
            if args.agent and entry.get("agent_id") != args.agent:
                continue

            # Filter by severity
            if args.severity and entry.get("severity") != args.severity:
                continue

            # Print
            timestamp = entry["timestamp"]
            severity = entry["severity"]
            pattern = entry["pattern_name"]
            agent = entry["agent_id"]
            action = entry["action"]

            emoji = {
                "CRITICAL": "🚨",
                "HIGH": "⚠️ ",
                "MEDIUM": "⚠️ ",
                "LOW": "ℹ️ "
            }

            print(f"{timestamp} {emoji[severity]} [{severity}] {pattern}")
            print(f"   Agent: {agent}, Action: {action.upper()}")
            if args.verbose:
                print(f"   Context: {entry.get('context', '')}")
            print()


def cmd_test_alert(args):
    """Send a test alert to verify webhook configuration."""
    if not args.webhook:
        print("❌ --webhook is required for test-alert", file=sys.stderr)
        sys.exit(1)

    dispatcher = AlertDispatcher(webhook_urls=args.webhook, verbose=True)

    if not dispatcher.configured:
        print("❌ No valid destinations parsed from --webhook", file=sys.stderr)
        sys.exit(1)

    print(f"📨 Sending test alert to {len(dispatcher.destinations)} destination(s)...")
    for dest in dispatcher.destinations:
        parsed = urlparse(dest)
        scheme = parsed.scheme or "unknown"
        print(f"   → {scheme}: {dest[:60]}{'...' if len(dest) > 60 else ''}")

    # Create a synthetic test pattern
    test_pattern = DetectionPattern(
        id="TEST_ALERT",
        name="Test alert",
        severity="LOW",
        regex="test",
        action="alert",
        description="This is a test alert from declaw-monitor to verify webhook delivery.",
    )

    sent = dispatcher.send(test_pattern, agent_id="test-agent", context="Test alert payload", action_taken="test")
    print(f"\n✅ Delivered to {sent}/{len(dispatcher.destinations)} destination(s)")

    if sent < len(dispatcher.destinations):
        print(f"⚠️  {len(dispatcher.destinations) - sent} destination(s) failed")
        sys.exit(1)


def cmd_patterns(args):
    """List available detection patterns."""
    detector = AnomalyDetector(
        openclaw_dir=Path.home() / ".openclaw",
        verbose=True
    )

    print("Available Detection Patterns:\n")

    by_severity = {}
    for pattern in detector.patterns:
        if pattern.severity not in by_severity:
            by_severity[pattern.severity] = []
        by_severity[pattern.severity].append(pattern)

    for severity in ["CRITICAL", "HIGH", "MEDIUM", "LOW"]:
        if severity not in by_severity:
            continue

        print(f"{'='*60}")
        print(f"{severity} Severity")
        print(f"{'='*60}\n")

        for pattern in by_severity[severity]:
            emoji = {
                "kill": "💀",
                "alert": "📨",
                "block": "🚫"
            }

            print(f"{emoji.get(pattern.action, '📋')} {pattern.id}: {pattern.name}")
            print(f"   Action: {pattern.action.upper()}")
            print(f"   Description: {pattern.description}")
            print(f"   Regex: {pattern.regex.pattern[:80]}...")
            print()


def main():
    parser = argparse.ArgumentParser(
        description="DeClaw Monitor - Real-time anomaly detection for OpenClaw"
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    # monitor command
    monitor_parser = subparsers.add_parser("monitor", help="Start monitoring")
    monitor_parser.add_argument(
        "--openclaw-dir",
        default="~/.openclaw",
        help="OpenClaw directory (default: ~/.openclaw)"
    )
    monitor_parser.add_argument(
        "--agent",
        help="Monitor specific agent only"
    )
    monitor_parser.add_argument(
        "--kill-switch",
        action="store_true",
        help="Enable automatic container killing on CRITICAL detections"
    )
    monitor_parser.add_argument(
        "--webhook",
        help=("Alert destinations (comma-separated). Supported schemes: "
              "telegram://BOT_TOKEN@CHAT_ID, "
              "slack://hooks.slack.com/..., "
              "smtp://user:pass@host:port?to=addr, "
              "https://custom-webhook.example.com")
    )
    monitor_parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Verbose output"
    )
    monitor_parser.set_defaults(func=cmd_monitor)

    # audit command
    audit_parser = subparsers.add_parser("audit", help="Show detection audit log")
    audit_parser.add_argument("--agent", help="Filter by agent")
    audit_parser.add_argument("--severity", choices=["CRITICAL", "HIGH", "MEDIUM", "LOW"])
    audit_parser.add_argument("-v", "--verbose", action="store_true")
    audit_parser.set_defaults(func=cmd_audit)

    # test-alert command
    test_alert_parser = subparsers.add_parser(
        "test-alert", help="Send a test alert to verify webhook configuration"
    )
    test_alert_parser.add_argument(
        "--webhook",
        required=True,
        help=("Alert destinations (comma-separated). Same format as monitor --webhook")
    )
    test_alert_parser.set_defaults(func=cmd_test_alert)

    # patterns command
    patterns_parser = subparsers.add_parser("patterns", help="List detection patterns")
    patterns_parser.set_defaults(func=cmd_patterns)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
